{% extends 'admin.twig' %}

{% set title %}{{ 'RebelAdConversions_AdConversions'|translate }}{% endset %}

{% block content %}
<div class="card rebelAdConversions">
    <div class="card-content">
        <h2 class="card-title">{{ 'RebelAdConversions_AdConversions'|translate }}</h2>
        <p>{{ 'RebelAdConversions_Intro'|translate(attributionDays) }}</p>

        <form method="get" action="index.php">
            <input type="hidden" name="module" value="RebelAdConversions">
            <input type="hidden" name="action" value="index">
            <label for="rebelAdConversionsSite">{{ 'General_Website'|translate }}</label>
            <select id="rebelAdConversionsSite" name="idSite" class="browser-default">
                {% for site in sites %}
                    <option value="{{ site.idsite }}" {% if site.idsite == idSite %}selected{% endif %}>{{ site.name|raw }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn">{{ 'General_Apply'|translate }}</button>
        </form>

        <h3>{{ 'RebelAdConversions_ExportedTitle'|translate }}</h3>
        {% if conversionNames is empty %}
            <p>{{ 'RebelAdConversions_NothingExported'|translate }}</p>
        {% else %}
            <p>{{ 'RebelAdConversions_Exported'|translate }}</p>
            <ul class="browser-default">
                {% for name in conversionNames %}<li>{{ name }}</li>{% endfor %}
            </ul>
        {% endif %}
        <p><a href="{{ settingsUrl }}">{{ 'RebelAdConversions_ChangeSettings'|translate }}</a></p>

        <h3>{{ 'RebelAdConversions_ConsentTitle'|translate }}</h3>
        <p>{{ 'RebelAdConversions_Consent'|translate }}</p>
        <pre>_paq.push(['RebelAdConversions::setConsentGiven']);</pre>

        <h3>{{ 'RebelAdConversions_FilesTitle'|translate }}</h3>
        <p>{{ 'RebelAdConversions_Files'|translate(days, maxDays) }}</p>
        <table class="entityTable">
            <thead>
                <tr>
                    <th>{{ 'RebelAdConversions_Platform'|translate }}</th>
                    <th>{{ 'RebelAdConversions_ClicksStored'|translate(days) }}</th>
                    <th>{{ 'RebelAdConversions_File'|translate }}</th>
                    <th>{{ 'RebelAdConversions_ScheduledUrl'|translate }}</th>
                </tr>
            </thead>
            <tbody>
                {% for platform in platforms %}
                    <tr>
                        <td>{{ platform.name }}</td>
                        <td>{{ platform.clicks }}</td>
                        <td><a href="{{ platform.downloadUrl }}">{{ 'General_Download'|translate }}</a></td>
                        <td><input type="text" readonly class="browser-default" style="width:100%" value="{{ platform.scheduledUrl }}"></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p>{{ 'RebelAdConversions_TokenHelp'|translate }}</p>
        <form method="post" action="{{ resetUrl }}">
            <input type="hidden" name="nonce" value="{{ nonce }}">
            <button type="submit" class="btn">{{ 'RebelAdConversions_ResetToken'|translate }}</button>
        </form>
    </div>
</div>
{% endblock %}
